# Pass git hash variables
set(git_date @git_date@)
set(git_hash @git_hash@)
set(git_branch @git_branch@)
set(git_description @git_description@)

# Maximum length of branch name allowed in Fortran's fixed-format
set(max_length 59)

# Shorten branch name to maximum fixed-format length
string(LENGTH @git_branch@ length)
if(length GREATER max_length)
  string(SUBSTRING @git_branch@ 0 ${max_length} git_branch)
  set(git_branch "${git_branch}...)")
endif()

# Maximum length of description name
set(desc_length 40)

# Shorten description name to maximum declared length
string(LENGTH @git_description@ dlength)
if(dlength GREATER desc_length)
  string(SUBSTRING @git_description@ 0 ${desc_length} git_description)
  set(git_description "${git_description}...)")
endif()

# No longer needed as the version.f file is ignored
# set(git_ignore_command
#     git update-index --assume-unchanged @PROJECT_SOURCE_DIR@/assistant/version.f)
# execute_process(COMMAND ${GIT_EXECUTABLE} ${git_ignore_command}
#                 WORKING_DIRECTORY @PROJECT_SOURCE_DIR@/..)

# Configures the version output into this build's binary directory
# (EIRENE_VERSION_F), not the shared source tree, so that concurrent standalone
# and coupled builds do not race writing a single assistant/version.f.
configure_file(@PROJECT_SOURCE_DIR@/cmake/version.f.in
               @EIRENE_VERSION_F@)
