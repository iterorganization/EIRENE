# DEFINES += -DRECL_UNITS_PER_DOUBLE=8 -DNO_F01AAF -DNO_SAVE

CPP     = -/lib/cpp -C -traditional -ffreestanding

MPI_FC ?= mpifort
ifdef SOLPS_MPI
 FC     = ${MPI_FC}
 COMPILER_TYPE = $(shell ${FC} --version | head -1 | cut -d ' ' -f 1)
 ifeq (${COMPILER_TYPE},GNU)
  COMPILER_REDEF = yes
 endif
else
 ifdef USE_IMPGYRO
  FC    = ${MPI_FC}
  COMPILER_TYPE = $(shell ${FC} --version | head -1 | cut -d ' ' -f 1)
  ifeq (${COMPILER_TYPE},GNU)
   COMPILER_REDEF = yes
  endif
 endif
endif

ifndef COMPILER_REDEF
 FCOPTS  = -assume no2underscore -fPIC
 ifndef SOLPS_DEBUG
  FCOPTS += -O3 -xavx
  CFLAGS += -O3
 endif
endif

GKS     = ${LD_GR} ${LD_GKS} -lX11 -lXt -lxcb

LDLIBS  = #-L/usr/local/lib -L/usr/X11R6/lib64


#!!!Local Variables:
#!!! mode: Makefile
#!!! End:
