# Test whether necessary variables are set
ifdef GLI_HOME
LD_GKS   ?= -L${GLI_HOME} -lgks -lgfortran
endif
ifdef GR_ROOT
LD_GR    ?= -L${GR_ROOT}/lib -lgr
endif
LD_NAG   ?= -L${NAGDIR}/lib -lnag
ifdef SOLPS_MPI
ifndef MPDIR
  $(error MPDIR not defined)
endif
endif

CPP       = -/lib/cpp -traditional -ffreestanding

ifdef SOLPS_DEBUG
FCOPTS    = -Mrecursive
else
FCOPTS    = -O1
endif

ifdef LD_GR
ifdef LD_GKS
GKS       = ${LD_GR} ${LD_GKS} -lX11 -lXt
endif
endif

LDLIBS    = -L/usr/local/lib -L/usr/X11R6/lib

#!!!Local Variables:
#!!! mode: Makefile
#!!! End:
