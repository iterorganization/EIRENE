# Test whether necessary variables are set
ifndef LD_NAG
  $(error LD_NAG not defined)
endif
ifdef GR_ROOT
LD_GR    ?= -L${GR_ROOT}/lib -lgr
endif
ifdef GLI_HOME
LD_GKS   ?= -L${GLI_HOME} -lgks -lgfortran
endif

CPP       = -/lib/cpp -traditional

FCOPTS    = -fno-second-underscore -DDECLARE_MPI_WTIME
ifdef SOLPS_DEBUG
FCOPTS   += -ffpe-trap=denormal -fsignaling-nans
CFLAGS    = -check
endif

ifdef LD_GR
ifdef LD_GKS
GKS       = ${LD_GR} ${LD_GKS} -lX11 -lXt
endif
endif

LDLIBS    = -L/usr/local/lib -L/usr/X11R6/lib

INCMOD    = -B

COMPILE   = ${FC} -c ${FCOPTS} ${INCMOD}${OBJDIR}

#!!!Local Variables:
#!!! mode: Makefile
#!!! End:
