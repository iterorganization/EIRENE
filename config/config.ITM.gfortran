# Test whether necessary variables are set
GLI_HOME ?= ${EBROOTGLI}
GR_ROOT  ?= ${EBROOTGR}
MPDIR    ?= ${OPENMPI_HOME}
LD_GKS   ?= -L${GLI_HOME} -lgks -lgfortran
LD_GR    ?= -L${GR_ROOT}/lib -lgr
LD_MPI   ?= -L${MPDIR}/lib64 -lmpi

CPP       = /lib/cpp -traditional

MPI_FC   ?= mpifort
ifdef SOLPS_MPI
FC        = ${MPI_FC}
else
ifdef USE_IMPGYRO
FC        = ${MPI_FC}
endif
endif

FCOPTS    = -fno-second-underscore
ifdef SOLPS_DEBUG
FCOPTS   += -ffpe-trap=denormal
CFLAGS    = -fcheck=all
endif

GKS       = ${LD_GR} ${LD_GKS} -lX11 -lXt
JSON_INC  = -I/gw/swimas/software/json-fortran/8.5.2-GCC-13.2.0/include

LDLIBS    = -L/usr/local/lib

ifdef SOLPS_MPI
LDLIBS   += ${LD_MPI}
endif

INCMOD    = -B

COMPILE   = ${FC} -c ${FCOPTS} ${INCMOD}${OBJDIR}

#!!!Local Variables:
#!!! mode: Makefile
#!!! End:
