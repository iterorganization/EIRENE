# Test whether necessary variables are set
ifndef LD_NAG
  $(error LD_NAG not defined)
endif

# DEFINES += -DRECL_UNITS_PER_DOUBLE=8 -DNO_F01AAF

ifdef SOLPS_MPI
DEFINES += -DMPI_VERSION=${MPI_VERSION} -DMPI_MOD=${MPI_MOD}
endif
DEFINES += -DNO_JSON

CPP      = /usr/ccs/lib/cpp
FC       = /opt/SUNWspro/bin/f77

FCOPTS   = -i4 -Nl100 -fns
ifdef SOLPS_DEBUG
FCOPTS  += -g
else
FCOPTS  += -O3 # -autopar
endif

COMPILE  = ${FC} -c ${FCOPTS}

NAG      = ${LD_NAG}
ifdef LD_GR
ifdef LD_GKS
ifdef GLI_HOME
GKS      = ${LD_GR} ${LD_GKS} -lX11 -lXt -lsocket -lnsl
endif
endif
endif

LDLIBS   = -L/usr/local/lib
LDEXTRA  =

# new

INCMOD   = -M
MOD      = mod
OBJDEST  = -o $@

#!!!Local Variables:
#!!! mode: Makefile
#!!! End:
