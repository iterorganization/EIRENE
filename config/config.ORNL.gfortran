# Test whether necessary variables are set
GR_ROOT  ?= /usr/local/grsource/linux_gfortran_JDL
GLI_HOME ?= /usr/local/gligks/gks/linux_gfortran_JDL
SOLPSLIB ?= ${SOLPSTOP}/lib/${HOST_NAME}.${COMPILER}
LD_GR    ?= -L${GR_ROOT} -lgr
LD_GKS   ?= -L${GLI_HOME} -lgks
LD_NAG   ?= -L${SOLPSLIB} -lblas -llapack

CPP       = -/lib/cpp -traditional

MPI_FC   ?= mpif90
ifdef SOLPS_MPI
FC        = ${MPI_FC}
else
ifdef USE_IMPGYRO
FC        = ${MPI_FC}
endif
endif

ifdef SOLPS_DEBUG
#FCOPTS   = -fbounds-check #-fno-second-underscore
FCOPTS    = -frange-check -fbounds-check -Wcharacter-truncation -ffpe-trap=denormal -fsignaling-nans \
-Waliasing -Wampersand -Wconversion -Wsurprising -Wc-binding-type -Wintrinsics-std -Wintrinsic-shadow -Wline-truncation -Wtarget-lifetime -Wreal-q-constant #-Wall
# -Wimplicit-interface -Wunused-parameter -Wunused -Wtabs
else
FCOPTS    = #-fno-second-underscore
endif

COMPILE   = ${FC} -c ${FCOPTS}

GKS       = ${LD_GR} ${LD_GKS} -lX11 -lXt

LDLIBS    =

INCMOD    = -B

#!!!Local Variables:
#!!! mode: Makefile
#!!! End:
