ifeq (${FC},f77)
FC = gfortran
endif
ifeq (${CC},cc)
ifneq (${FC},ftn)
CC = /usr/bin/gcc
endif
endif
ifndef SOLPS_CPP
DEFINES  += -DGFORTRAN
endif

# Build with JSON if present
ifeq ($(shell `pkg-config --exists json-fortran`; echo $$?),0)
  JSON_INC ?= $(shell pkg-config json-fortran --cflags)
  LD_JSON ?= $(shell pkg-config json-fortran --libs)
else
  ifndef SOLPS_CPP
    DEFINES += -DNO_JSON
  endif
endif

INCLUDE  += ${JSON_INC}

GFORTRAN_VERSION = $(shell ${FC} --version | head -1 | awk 'match($$0,/[0-9]+\.[0-9]+\.[0-9]+/){print substr($$0, RSTART, RLENGTH)}')

GFORTRAN_MAJOR_VERSION = $(shell echo ${GFORTRAN_VERSION} | cut -d '.' -f 1 )
GFORTRAN_MINOR_VERSION = $(shell echo ${GFORTRAN_VERSION} | cut -d '.' -f 2 )

DEFINES  += -DCOMPILER_MAJOR_VERSION=${GFORTRAN_MAJOR_VERSION} -DCOMPILER_MINOR_VERSION=${GFORTRAN_MINOR_VERSION}

ifdef SOLPS_DEBUG
FCOPTS   += -g -fcheck=all -fbacktrace -frecursive -ffpe-trap=invalid -ffpe-trap=zero -ftrapv
CFLAGS   += -g
else
FCOPTS   += -O2
CFLAGS   += -O2
endif

ifdef SOLPS_OPENMP
FCOPTS   += -fopenmp
LDOPTS   += -fopenmp
endif

ifdef SOLPS_MPI
DEFINES  += -DMPI_VERSION=${MPI_VERSION} -DMPI_MOD=${MPI_MOD}
endif

NAG       = ${LD_NAG}

LDEXTRA   = ${LD_JSON}

# new

MOD       = mod
OBJDEST   = -J${OBJDIR} -o $@

#!!!Local Variables:
#!!! mode: Makefile
#!!! End:
