# Test whether necessary variables are set
GR_ROOT  ?= /usr/local/grsource/linux_pgf90_JDL
GLI_HOME ?= /usr/local/gligks/gks/linux_pgf90_JDL
#ifndef SOLPSLIB
#  $(error SOLPSLIB not defined)
#endif
LD_GR    ?= -L${GR_ROOT} -lgr
LD_GKS   ?= -L${GLI_HOME} -lgks
LD_NAG   ?= -L${SOLPSLIB} -lblas -llapack
ifdef SOLPS_MPI
ifndef MPDIR
  $(error MPDIR not defined)
endif
endif

CPP       = -/lib/cpp -traditional

ifdef SOLPS_DEBUG
FCOPTS    = -C
else
FCOPTS    = -fast
endif

GKS       = ${LD_GR} ${LD_GKS} -lX11 -lXt

LDLIBS    =

