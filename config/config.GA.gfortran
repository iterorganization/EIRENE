# Test whether necessary variables are set
IRISLIB  ?= /fusion/projects/codes/solps/SOLPS-ITER/public_lib/GA.gfortran
GR_ROOT  ?= ${IRISLIB}
GLI_HOME ?= ${IRISLIB}/gli/src
NAGDIR   ?= ${IRISLIB}
LD_GR    ?= -L${GR_ROOT} -lgr
LD_GKS   ?= -L${GLI_HOME} -lgks -lgfortran
LD_NAG   ?= -L${NAGDIR} -llapack -lblas

CPP       = /lib/cpp -traditional

MPI_FC   ?= mpif90
ifdef SOLPS_MPI
FC        = ${MPI_FC}
else
ifdef USE_IMPGYRO
FC        = ${MPI_FC}
endif
endif

FCOPTS    = -fno-second-underscore
ifdef SOLPS_DEBUG
FCOPTS   += -ffpe-trap=denormal -fsignaling-nans
CFLAGS    = -check
endif

GKS       = ${LD_GR} ${LD_GKS} -lX11 -lXt

LDLIBS    = -L/usr/local/lib -L/usr/X11R6/lib

INCMOD    = -B

COMPILE   = ${FC} -c ${FCOPTS} ${INCMOD}${OBJDIR}

#!!!Local Variables:
#!!! mode: Makefile
#!!! End:
