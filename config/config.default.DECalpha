# Test whether necessary variables are set
ifndef LD_NAG
  $(error LD_NAG not defined)
endif

# DEFINES += -DRECL_UNITS_PER_DOUBLE=2

CPP       = /usr/ucb/cpp -C
FC        = f77

ifdef SOLPS_DEBUG
FCOPTS    = -i4 -g
else
FCOPTS    = -i4 -fast
endif

ifdef SOLPS_MPI
DEFINES  += -DMPI_VERSION=${MPI_VERSION} -DMPI_MOD=${MPI_MOD}
endif
DEFINES  += -DNO_JSON

COMPILE   = ${FC} -c ${FCOPTS}

NAG       = ${LD_NAG}
ifdef LD_GR
ifdef LD_GKS
ifdef GLI_HOME
GKS       = ${LD_GR} ${LD_GKS} -lX11 -lXt
endif
endif
endif

LDLIBS    = -L/usr/local/lib 
LDEXTRA   = 

OBJDEST   = -o $@

#!!!Local Variables:
#!!! mode: Makefile
#!!! End:
