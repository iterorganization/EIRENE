#  VERSION : 11.02.98 19:06

# Test whether necessary variables are set
ifndef LD_NAG
  $(error LD_NAG not defined)
endif

# File compiler.macro for SGI f90

ifdef SOLPS_MPI
DEFINES += -DMPI_VERSION=${MPI_VERSION} -DMPI_MOD=${MPI_MOD}
endif
DEFINES += -DNO_JSON

FC      = f90
#FCOPTS  = -static -O2 -nocpp -Olimit 2000
FCOPTS  = -static -nocpp -O
COMPILE = ${FC} -c ${FCOPTS}
CPP     = /lib/cpp

NAG     = ${LD_NAG}
ifdef LD_GR
ifdef LD_GKS
ifdef GLI_HOME
GKS     = ${LD_GR} ${LD_GKS} -lX11 -lXt
endif
endif
endif

LDLIBS  =
LDEXTRA =

OBJDEST = -o $@

#!!!Local Variables:
#!!! mode: Makefile
#!!! End:
