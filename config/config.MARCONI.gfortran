# Test whether necessary variables are set
GLI_HOME ?= /marconi_work/FUSIO_ALL/SOLPS-ITER/${COMPILER}/gks
GR_ROOT  ?= /marconi_work/FUSIO_ALL/SOLPS-ITER/${COMPILER}/gr
MPDIR    ?= ${INTELMPI_HOME}
LD_GKS   ?= -L${GLI_HOME} -lgks -lgfortran
LD_GR    ?= -L${GR_ROOT} -lgr
LD_MPI   ?= -L${MPDIR}/lib64 -lmpi -lmpigf

CPP       = /lib/cpp -traditional

MPI_FC   ?= mpif90
ifdef SOLPS_MPI
FC        = ${MPI_FC}
else
ifdef USE_IMPGYRO
FC        = ${MPI_FC}
endif
endif

FCOPTS    = -fno-second-underscore
ifdef SOLPS_DEBUG
FCOPTS   += -ffpe-trap=denormal
CFLAGS    = -fcheck=all
endif

GKS       = ${LD_GR} ${LD_GKS} -lX11 -lXt

LDLIBS    = -L/usr/local/lib -L/usr/X11R6/lib

ifdef SOLPS_MPI
LDLIBS   += ${LD_MPI}
endif

INCMOD    = -B

COMPILE   = ${FC} -c ${FCOPTS} ${INCMOD}${OBJDIR}

#!!!Local Variables:
#!!! mode: Makefile
#!!! End:
