# Test whether necessary variables are set
GR_ROOT  ?=  ${SOLPSLIB}/gr
GLI_HOME ?= ${SOLPSLIB}/gli/src/gks
LD_GR    ?= -L${GR_ROOT} -lgr
LD_GKS   ?= -L${SOLPSLIB}/gli/src/gks -lgks

CPP       = CC -traditional
FC        = ftn
CC        = cc

ifdef SOLPS_DEBUG
#FCOPTS   = -fbounds-check #-fno-second-underscore
FCOPTS    = -frange-check -fbounds-check -Wcharacter-truncation -ffpe-trap=denormal -fsignaling-nans \
-Waliasing -Wampersand -Wconversion -Wsurprising -Wc-binding-type -Wintrinsics-std -Wintrinsic-shadow -Wline-truncation -Wtarget-lifetime -Winteger-division -Wreal-q-constant #-Wall
# -Wimplicit-interface -Wunused-parameter -Wunused -Wtabs
else
FCOPTS    = #-fno-second-underscore
endif

COMPILE   = ${FC} -c ${FCOPTS}

GKS       = ${LD_GR} ${LD_GKS} -lX11 -lXt

LDLIBS    =

INCMOD    = -I

# Build with JSON if present
ifeq ($(shell `pkg-config --exists json-fortran`; echo $$?),0)
  JSON_INC ?= $(shell pkg-config json-fortran --cflags)
  LD_JSON ?= $(shell pkg-config json-fortran --libs)
else
  ifndef SOLPS_CPP
    DEFINES += -DNO_JSON
  endif
endif

INCLUDE  += ${JSON_INC}

#!!!Local Variables:
#!!! mode: Makefile
#!!! End:
